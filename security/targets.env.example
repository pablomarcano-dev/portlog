# Copy to targets.env to enable `run-scanners.sh --prod`.
# targets.env is gitignored — it names infrastructure, so it stays local.
#
# The --prod scans are read-only by design (nmap service detection, TLS probing,
# Nuclei templates, ZAP *baseline* which is passive). Nothing here sends a
# mutating request. Never add zap-full-scan or zap-api-scan to this path: they
# submit forms and would write real records into a system that generates legally
# binding documents.

PROD_HOST=167.233.48.84
PROD_URL=https://167.233.48.84.sslip.io
SSH_PORT=22
