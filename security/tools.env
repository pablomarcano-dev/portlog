# Container images used by run-scanners.sh.
#
# Everything runs through Docker because none of these tools are installed
# natively, and containers keep the audit reproducible: the same image ref
# produces the same findings. run-scanners.sh records the resolved digest of
# every image it pulls into coverage.json, so a report can always be traced
# back to the exact scanner build that produced it.
#
# Once you have seen a run you are happy with, replace the floating tags below
# with the digests from that run's coverage.json (image@sha256:...). Until then
# a scanner upgrade can change findings between runs, which is the one thing
# that undermines week-over-week diffing.

IMG_GITLEAKS="zricethezav/gitleaks:latest"
IMG_TRUFFLEHOG="trufflesecurity/trufflehog:latest"
IMG_SEMGREP="semgrep/semgrep:latest"
IMG_TRIVY="aquasec/trivy:latest"
IMG_SYFT="anchore/syft:latest"
IMG_GRYPE="anchore/grype:latest"
IMG_OSV="ghcr.io/google/osv-scanner:latest"
IMG_HADOLINT="hadolint/hadolint:latest-debian"

# --prod only (network-active, opt-in)
IMG_NMAP="instrumentisto/nmap:latest"
IMG_TESTSSL="drwetter/testssl.sh:latest"
IMG_NUCLEI="projectdiscovery/nuclei:latest"
IMG_ZAP="ghcr.io/zaproxy/zaproxy:stable"

# Semgrep rule packs. p/secrets overlaps gitleaks deliberately — different
# engines miss different things, and secrets are the finding we least want to
# miss. .semgrep/ (repo-local custom rules) is added automatically when present.
SEMGREP_CONFIGS="p/typescript p/nodejs p/owasp-top-ten p/secrets"
