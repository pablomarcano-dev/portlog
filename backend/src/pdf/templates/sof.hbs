<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><style>
@page { margin: 24px; }
.closing { break-inside: avoid; }
body { font-family: Arial, sans-serif; font-size: 12px; margin: 0; padding: 0; }
h1 { font-size: 16px; border-bottom: 2px solid #333; padding-bottom: 8px; }
pre { font-family: monospace; font-size: 11px; white-space: pre-wrap; overflow-wrap: anywhere; }
.signature { margin-top: 32px; display: flex; justify-content: space-between; }
.sig-block { text-align: center; width: 40%; border-top: 1px solid #333; padding-top: 8px; }
.footer { margin-top: 12px; font-size: 10px; color: #666; }
</style></head><body>
<h1>{{sofTitle}}</h1>
<p><strong>Revision:</strong> {{revisionNumber}} - {{revisionLabel}}</p>
<pre>{{sofBody}}</pre>
<div class="closing"><div class="signature"><div class="sig-block">Master / Captain</div><div class="sig-block">Port Agent</div></div>
<div class="footer">Generated: {{generatedAt}}</div></div>
</body></html>
