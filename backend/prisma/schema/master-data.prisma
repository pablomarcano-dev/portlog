// ---------------------------------------------------------------------------
// M2 — Master Data
// ---------------------------------------------------------------------------
// All master-data entities follow the same conventions:
//   - cuid() primary keys (consistent with User, AuditLog)
//   - snake_case plural table names via @@map
//   - comments String? @db.Text — new requirement across all legacy forms
//   - createdAt / updatedAt with @db.Timestamptz for UTC storage
//   - name indexes on lookup-heavy tables
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Flag — country flag codes (ISO 3166-1)
// ---------------------------------------------------------------------------
model Flag {
  id           String   @id @default(cuid())
  name         String   @unique
  abbreviation String?
  comments     String?  @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  shipParticulars ShipParticular[]

  @@index([name])
  @@map("flags")
}

// ---------------------------------------------------------------------------
// Activity — operational activity types
// ---------------------------------------------------------------------------
model Activity {
  id        String   @id @default(cuid())
  name      String   @unique
  comments  String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // SOF back-relation
  sofEntries SofEntry[] @relation("SofEntryActivity")

  @@map("activities")
}

// ---------------------------------------------------------------------------
// Cargo — cargo type catalog (a.k.a. "products" on nomination parcels)
// category gates which nominations a product may appear on: OT nominations only
// accept OT-category products; SN products (the default) are unrestricted.
// ---------------------------------------------------------------------------
enum CargoCategory {
  SN
  OT
}

model Cargo {
  id        String        @id @default(cuid())
  name      String
  bblUnit   String // e.g. "BBL", "MT"
  category  CargoCategory @default(SN)
  comments  String?       @db.Text
  createdAt DateTime      @default(now()) @db.Timestamptz
  updatedAt DateTime      @updatedAt @db.Timestamptz

  @@map("cargoes")
}

// ---------------------------------------------------------------------------
// Port — flat port directory; piers are a child table (Pier)
// ---------------------------------------------------------------------------
model Port {
  id           String   @id @default(cuid())
  name         String
  abbreviation String?
  country      String?
  // The terminal's own distribution list — who is written to when a notice is
  // addressed to the terminal itself (ETA forwarded to terminal), as opposed to
  // the nomination's client list. Distinct from `emailGroup`, which is a
  // free-text label and names no addresses.
  emails       String[] @default([])
  emailGroup   String?
  comments     String?  @db.Text
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  piers Pier[]

  // Named back-relations for the port FK fields on Nomination
  nominationsAsOpPort   Nomination[] @relation("NominationOpPort")
  nominationsAsLastPort Nomination[] @relation("NominationLastPort")
  nominationsAsNextPort Nomination[] @relation("NominationNextPort")
  nominationsAsDisPort  Nomination[] @relation("NominationDisPort")

  // SOF back-relations
  sofTimesheetsAsLastPort SofTimesheet[] @relation("SofTimesheetLastPort")
  sofTimesheetsAsNextPort SofTimesheet[] @relation("SofTimesheetNextPort")

  // Service Requests back-relation — the `Ubicación` port picker
  serviceRequests  ServiceRequest[]
  terminalContacts TerminalContact[]

  @@index([name])
  @@index([branchId])
  @@map("ports")
}

enum TerminalRecipientType {
  TO
  CC
  BCC
}

// Users who receive notices addressed to a terminal. The assignment owns the
// envelope placement so To/Cc/Bcc is configured once in master data.
model TerminalContact {
  id            String                @id @default(cuid())
  portId        String
  port          Port                  @relation(fields: [portId], references: [id], onDelete: Cascade)
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientType TerminalRecipientType @default(TO)
  createdAt     DateTime              @default(now()) @db.Timestamptz

  @@unique([portId, userId])
  @@index([userId])
  @@map("terminal_contacts")
}

// ---------------------------------------------------------------------------
// Pier — simple name list under a port; nominations reference a specific pier
// ---------------------------------------------------------------------------
model Pier {
  id        String   @id @default(cuid())
  name      String
  portId    String
  port      Port     @relation(fields: [portId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  nominations     Nomination[]
  sofTimesheets   SofTimesheet[]   @relation("SofTimesheetPier")
  serviceRequests ServiceRequest[]

  @@index([portId])
  @@map("piers")
}

// ---------------------------------------------------------------------------
// Crew — ship crew member directory
// ---------------------------------------------------------------------------
model Crew {
  id             String   @id @default(cuid())
  name           String
  position       String?
  documentNumber String?
  nationality    String?
  comments       String?  @db.Text
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@index([name])
  @@map("crew")
}

// ---------------------------------------------------------------------------
// Agent — port agents
// ---------------------------------------------------------------------------
model Agent {
  id              String               @id @default(cuid())
  name            String
  address         String?
  contactInfo     String?              @db.Text
  mobile          String?
  branchId        String?
  branch          Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  operationalRole UserOperationalRole?
  comments        String?              @db.Text
  createdAt       DateTime             @default(now()) @db.Timestamptz
  updatedAt       DateTime             @updatedAt @db.Timestamptz

  @@index([name])
  @@index([branchId])
  @@index([operationalRole])
  @@map("agents")
}

// ---------------------------------------------------------------------------
// Owner — vessel owners
// Contains CRM and financial fields.
// Access to agreements + historyJson is gated by the "owner.financial" permission
// (enforced in the service layer — guard implementation is in M2-S12).
// notes: free-text separate from the standard comments field (per legacy form).
// historyJson: JSON blob for Buques/OTs/Factura/PagosRecibidos — full normalization deferred.
// ---------------------------------------------------------------------------
model Owner {
  id              String   @id @default(cuid())
  contactList     String?
  quantity        Int?
  contactNumber   String?
  name            String
  physicalAddress String?
  phones          String?
  address         String?
  position        String?
  socialMedia     String?
  // Free-text CRM field separate from the standard `comments` column (per legacy form spec)
  notes           String?  @db.Text
  birthday        String?
  preferences     String?  @db.Text
  recommendations String?  @db.Text
  business        String?  @db.Text
  webpage         String?
  // Financial fields — access gated by "owner.financial" permission (M2-S12)
  agreements      String?  @db.Text
  // JSON blob for Buques / OTs / Factura / PagosRecibidos history.
  // Full relational normalization deferred to a future milestone.
  historyJson     Json?
  comments        String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  contacts          Contact[]
  shipParticulars   ShipParticular[]
  nominationClients NominationClient[]

  @@index([name])
  @@map("owners")
}

// ---------------------------------------------------------------------------
// Supplier — service providers (Proveedores)
// ---------------------------------------------------------------------------
model Supplier {
  id              String   @id @default(cuid())
  name            String
  contacts        String?  @db.Text
  address         String?
  services        String?  @db.Text
  kyc             String?  @db.Text
  phones          String?
  emails          String[] @default([])
  certificates    String?  @db.Text
  rates           String?  @db.Text
  serviceContract String?  @db.Text
  agreements      String?  @db.Text
  comments        String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  // Service Requests back-relation — the Proveedor an OC is emailed to
  serviceRequests ServiceRequest[]

  @@index([name])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Client — port agency clients (Clientes)
// ---------------------------------------------------------------------------
enum ClientEntityType {
  CLIENT
  CHARTERER
  SHIPPER
  OPERATOR
}

enum PhoneKind {
  BUSINESS
  HOME
  MOBILE
  FAX
  OTHER
}

enum AddressPurpose {
  PHYSICAL
  BILLING
  POSTAL
  TAX
  OTHER
}

enum ClientLocationType {
  LOCAL
  EXTERIOR
}

enum ClientEmailSlot {
  FIRST_MESSAGE
  SECOND_MESSAGE
  THIRD_MESSAGE
  CC_MESSAGE
}

model Client {
  id                   String              @id @default(cuid())
  name                 String
  entityType           ClientEntityType    @default(CLIENT)
  emails               String[]            @default([])
  instructions         String?             @db.Text
  notes                String?             @db.Text
  locationType         ClientLocationType?
  phones               ClientPhone[]
  addresses            ClientAddress[]
  tariffItems          ClientTariffItem[]
  emailGroups          ClientEmailGroup[]
  contactLinks         ClientContact[]
  nominations          Nomination[]        @relation("InstructionClient")
  chartererNominations Nomination[]        @relation("NominationCharterer")
  nominationClients    NominationClient[]
  shipParticulars      ShipParticular[]    @relation("VesselOperator")
  serviceRequests      ServiceRequest[]
  createdAt            DateTime            @default(now()) @db.Timestamptz
  updatedAt            DateTime            @updatedAt @db.Timestamptz

  @@index([name, id])
  @@index([entityType])
  @@map("clients")
}

model ClientContact {
  clientId  String
  contactId String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@id([clientId, contactId])
  @@index([contactId])
  @@map("client_contacts")
}

model ClientPhone {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind      PhoneKind
  number    String
  label     String?
  sortOrder Int       @default(0)

  @@index([clientId])
  @@map("client_phones")
}

model ClientAddress {
  id        String         @id @default(cuid())
  clientId  String
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  purpose   AddressPurpose
  text      String
  label     String?
  sortOrder Int            @default(0)

  @@index([clientId])
  @@map("client_addresses")
}

model ClientTariffItem {
  id          String  @id @default(cuid())
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  item        String
  amountText  String?
  information String?
  sortOrder   Int     @default(0)

  @@index([clientId])
  @@map("client_tariff_items")
}

model ClientEmailGroup {
  clientId     String
  slot         ClientEmailSlot
  emailGroupId String
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  emailGroup   EmailGroup      @relation(fields: [emailGroupId], references: [id], onDelete: Cascade)

  @@id([clientId, slot])
  @@index([emailGroupId])
  @@map("client_email_groups")
}

// ---------------------------------------------------------------------------
// Service — sale service catalog (Servicios)
// No default price: price is always typed per sale. Distinct from the future
// M6 "service requests" operational module (SCOPE.md 08).
// ---------------------------------------------------------------------------
model Service {
  id        String   @id @default(cuid())
  name      String
  comments  String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([name])
  @@map("services")
}

// ---------------------------------------------------------------------------
// SalesContact — the people named on the paper service voucher: CONDUCTOR
// (driver) and USUARIO (whoever received the service).
//
// One flat directory feeds both fields; there is deliberately no driver/user
// role split, since the same person can appear in either line.
//
// Separate from Contact: these are service-voucher people and vehicle details.
// ---------------------------------------------------------------------------
model SalesContact {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  mobile         String?
  // Cédula / national ID, as written on the voucher.
  documentNumber String?
  // Vehicle or plate the driver operates.
  vehicle        String?
  comments       String?  @db.Text
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@index([name])
  @@map("sales_contacts")
}

// ---------------------------------------------------------------------------
// Contact — generic contacts directory
// Shared by multiple Clients through ClientContact; an optional Owner link remains.
// Communication fields use the same normalized shape as Client.
// ---------------------------------------------------------------------------
model Contact {
  id          String           @id @default(cuid())
  name        String
  emails      String[]         @default([])
  phones      ContactPhone[]
  addresses   ContactAddress[]
  notes       String?          @db.Text
  ownerId     String?
  owner       Owner?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  clientLinks ClientContact[]
  createdAt   DateTime         @default(now()) @db.Timestamptz
  updatedAt   DateTime         @updatedAt @db.Timestamptz

  @@index([name, id])
  @@map("contacts")
}

model ContactPhone {
  id        String    @id @default(cuid())
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  kind      PhoneKind
  number    String
  label     String?
  sortOrder Int       @default(0)

  @@index([contactId])
  @@map("contact_phones")
}

model ContactAddress {
  id        String         @id @default(cuid())
  contactId String
  contact   Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  purpose   AddressPurpose
  text      String
  label     String?
  sortOrder Int            @default(0)

  @@index([contactId])
  @@map("contact_addresses")
}

// ---------------------------------------------------------------------------
// Branch — company branches (Sucursal)
// Resolves Open Question #5 from SCOPE.md: screenshot confirms Branch is a
// dropdown FK on every nomination, not a label derived from Port.
// ---------------------------------------------------------------------------
model Branch {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique // short identifier e.g. "LGR", "PLC"
  comments      String?  @db.Text
  // Operational contact details — used in email signatures
  emails        String[] @default([]) // branch operational email(s) e.g. lgr@navieramar.com
  address       String?  @db.Text
  phone         String?
  fax           String?
  mobile24h     String? // 24h mobile(s), free text (may contain multiple numbers)
  coverage      String?  @db.Text // ports/terminals attended by this branch
  // Branch contact person
  contactName   String? // e.g. "Ms. Cindy Moreno"
  contactTitle  String? // e.g. "Branch Manager"
  contactMobile String?
  contactEmails String[] @default([])
  // Central emails to always CC
  centralEmails String[] @default([])
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  nominations       Nomination[]
  documentTemplates BranchDocumentTemplate[]
  serviceRequests   ServiceRequest[]
  // Users whose default Sucursal this is (pre-fills service request forms)
  users             User[]
  ports             Port[]
  agents            Agent[]

  @@index([code])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// ShipParticular — vessel registry
// imoNumber: unique when present; nullable (open question with client — allow null
//   for vessels not yet assigned an IMO or with non-standard entries, but uniqueness
//   is enforced among non-null values at DB level via @unique — Postgres silently
//   allows multiple NULLs in a unique index, which gives us partial-uniqueness semantics).
// callSign: marked @unique per business rule; open question whether duplicate
//   call signs across flags should be allowed — keeping @unique until client confirms otherwise.
// ---------------------------------------------------------------------------
model ShipParticular {
  id           String   @id @default(cuid())
  // Call sign is unique per vessel identification rules (open question: cross-flag duplicates allowed?)
  callSign     String   @unique
  name         String
  abbreviation String?
  loa          Decimal? @db.Decimal(10, 3) // Length Overall in metres
  dwt          Decimal? @db.Decimal(12, 3) // Deadweight Tonnage
  grt          Decimal? @db.Decimal(12, 3) // Gross Register Tonnage
  nrt          Decimal? @db.Decimal(12, 3) // Net Register Tonnage
  emails       String[] @default([])
  // imoNumber is unique among non-null values (Postgres unique index allows multiple NULLs).
  // Partial-uniqueness concern: Prisma @unique maps to a standard unique index, which is correct here.
  imoNumber    String?  @unique
  phone        String?
  phone2       String?
  fax          String?
  flagId       String
  flag         Flag     @relation(fields: [flagId], references: [id])
  ownerId      String?
  owner        Owner?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  operatorId   String?
  operator     Client?  @relation("VesselOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  comments     String?  @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  nominations     Nomination[]
  // Service Requests back-relation — the vessel is the module's anchor
  serviceRequests ServiceRequest[]

  @@index([name])
  @@index([imoNumber])
  @@map("ship_particulars")
}
