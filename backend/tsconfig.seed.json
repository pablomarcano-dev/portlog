{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "./prisma",
    "outDir": "./dist-seed",
    "esModuleInterop": true,
    "resolvePackageJsonExports": false
  },
  "include": ["prisma/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
