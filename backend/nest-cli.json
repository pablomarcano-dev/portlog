{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "assets": [
      { "include": "pdf/templates/**/*.hbs", "watchAssets": true },
      { "include": "nominations/templates/**/*.docx", "watchAssets": true }
    ],
    "watchAssets": true
  }
}
